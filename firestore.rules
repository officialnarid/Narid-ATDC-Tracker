rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Strict Zero-Trust UID-Based RBAC Helpers (Zero Email Bypasses)
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function hasUidIndex() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/user_uid_index/$(request.auth.uid));
    }

    function uidIndex() {
      return get(/databases/$(database)/documents/user_uid_index/$(request.auth.uid)).data;
    }

    function hasDirectUidRole() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid));
    }

    function directUidRole() {
      return get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data;
    }

    function isNotLocked() {
      return (!hasUidIndex() || uidIndex().lockStatus != 'LOCKED') &&
        (!hasDirectUidRole() || (directUidRole().lockStatus != 'LOCKED' && directUidRole().isLocked != true));
    }

    function callerRoleId() {
      return hasUidIndex() && uidIndex().role is string
        ? uidIndex().role.lower()
        : (hasDirectUidRole() && directUidRole().role is string ? directUidRole().role.lower() : '');
    }

    function isSystemRole(roleId) {
      return roleId in ['super_admin', 'admin', 'user'];
    }

    function isRoleActive() {
      return isSystemRole(callerRoleId()) ||
        (callerRoleId() != '' && (
          !exists(/databases/$(database)/documents/roles/$(callerRoleId())) ||
          get(/databases/$(database)/documents/roles/$(callerRoleId())).data.isActive != false
        ));
    }

    function isSuperAdmin() {
      return isSignedIn() && isNotLocked() && (
        (hasUidIndex() &&
          uidIndex().status == 'Active' &&
          uidIndex().role == 'super_admin') ||
        (hasDirectUidRole() &&
          directUidRole().status == 'Active' &&
          directUidRole().role == 'super_admin')
      );
    }

    function isAdmin() {
      return isSignedIn() && isNotLocked() && (
        isSuperAdmin() ||
        (hasUidIndex() &&
          uidIndex().status == 'Active' &&
          uidIndex().role == 'admin') ||
        (hasDirectUidRole() &&
          directUidRole().status == 'Active' &&
          directUidRole().role == 'admin')
      );
    }

    function isActiveUser() {
      return isSignedIn() && isNotLocked() && isRoleActive() && (
        isAdmin() ||
        (hasUidIndex() && uidIndex().status == 'Active') ||
        (hasDirectUidRole() && directUidRole().status == 'Active')
      );
    }

    function hasRoleModuleAction(mod, act) {
      return isSuperAdmin() || (
        isActiveUser() &&
        !(mod in ['user_rights', 'audit_logs', 'security_management', 'company_wifi_access']) &&
        callerRoleId() != '' &&
        exists(/databases/$(database)/documents/role_permissions/$(callerRoleId())) &&
        get(/databases/$(database)/documents/role_permissions/$(callerRoleId())).data.modulePermissions is map &&
        mod in get(/databases/$(database)/documents/role_permissions/$(callerRoleId())).data.modulePermissions &&
        get(/databases/$(database)/documents/role_permissions/$(callerRoleId())).data.modulePermissions[mod] is map &&
        act in get(/databases/$(database)/documents/role_permissions/$(callerRoleId())).data.modulePermissions[mod] &&
        get(/databases/$(database)/documents/role_permissions/$(callerRoleId())).data.modulePermissions[mod][act] == true
      );
    }

    function isOwnerByUidIndex(docId) {
      return isSignedIn() && (
        request.auth.uid == docId ||
        (hasUidIndex() && uidIndex().roleDocId == docId)
      );
    }

    // 0. Server-Maintained UID-to-Role Index (Admin SDK Only Writes)
    match /user_uid_index/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if isSuperAdmin();
      allow create, update, delete: if false; // Strictly Firebase Admin SDK only
    }

    // 1. User Roles & Accounts Directory (Admin SDK Only Writes)
    match /user_roles/{userRoleId} {
      allow list: if isSuperAdmin();
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        isOwnerByUidIndex(userRoleId) ||
        (resource != null && resource.data.authUid == request.auth.uid)
      );
      allow create, update, delete: if false; // Strictly Firebase Admin SDK only
    }

    // 2. Shared Role Definitions (Admin SDK Only Writes)
    match /roles/{roleId} {
      allow list, get: if isActiveUser();
      allow create, update, delete: if false; // Strictly Firebase Admin SDK only
    }

    // 3. Individual User Permissions (Admin SDK Only Writes)
    match /user_permissions/{permissionId} {
      allow list: if isSuperAdmin();
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        isOwnerByUidIndex(permissionId)
      );
      allow create, update, delete: if false; // Strictly Firebase Admin SDK only
    }

    // 4. Role Permissions Mapping (Admin SDK Only Writes)
    match /role_permissions/{roleId} {
      allow list, get: if isActiveUser();
      allow create, update, delete: if false; // Strictly Firebase Admin SDK only
    }

    // 5. Employees Master Directory
    match /employees/{employeeId} {
      allow list, get: if isActiveUser();
      allow create: if (isAdmin() || hasRoleModuleAction('employees', 'add')) && isValidId(employeeId) &&
        request.resource.data.employeeId is string &&
        request.resource.data.employeeName is string &&
        request.resource.data.employeeStatus in ['Active', 'Inactive'];
      allow update: if (isAdmin() || hasRoleModuleAction('employees', 'edit')) && isValidId(employeeId) &&
        request.resource.data.employeeId is string &&
        request.resource.data.employeeName is string &&
        request.resource.data.employeeStatus in ['Active', 'Inactive'];
      allow delete: if (isAdmin() || hasRoleModuleAction('employees', 'delete')) && isValidId(employeeId);
    }

    // 6. Attendance Daily Records (Server-Authoritative Backend API Only Writes)
    match /attendance/{attendanceId} {
      allow list, get: if isActiveUser();
      allow create, update, delete: if false; // Strictly via authenticated backend API (Admin SDK)
    }

    // 7. Individual Punch Events (Server-Authoritative Backend API Only Writes)
    match /punch_events/{eventId} {
      allow list, get: if isAdmin() || hasRoleModuleAction('scanner', 'view') || hasRoleModuleAction('history', 'view');
      allow create, update, delete: if false; // Strictly via authenticated backend API (Admin SDK)
    }

    // 8. Raw Punch Activity Logs (Server-Authoritative Backend API Only Writes)
    match /punch_logs/{logId} {
      allow list, get: if isAdmin() || hasRoleModuleAction('scanner', 'view') || hasRoleModuleAction('history', 'view');
      allow create, update, delete: if false; // Strictly via authenticated backend API (Admin SDK)
    }

    // 9. Enterprise Compliance Audit Logs (Admin SDK Only Writes)
    match /audit_logs/{auditId} {
      allow list, get: if isSuperAdmin();
      allow create, update, delete: if false; // Strictly Firebase Admin SDK only
    }

    // 9.1 Login History & Telemetry (Admin SDK Only)
    match /login_history/{historyId} {
      allow list, get: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // 9.2 Long-Term Audit Archives (Admin SDK Only)
    match /audit_archives/{archiveId} {
      allow list, get: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // 9.3 Permanent Controlled Audit Deletion Ledger (Admin SDK Only)
    match /audit_log_deletions/{deletionId} {
      allow list, get: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // 9.4 Password Reset Audit Trail (Admin SDK Only)
    match /password_reset_logs/{logId} {
      allow list, get: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // 10. Organization Hierarchy (Departments, Floors/Lines, Sections, Lines)
    match /departments/{departmentId} {
      allow list, get: if isActiveUser();
      allow create: if (isAdmin() || hasRoleModuleAction('organization', 'add')) && isValidId(departmentId);
      allow update: if (isAdmin() || hasRoleModuleAction('organization', 'edit')) && isValidId(departmentId);
      allow delete: if (isAdmin() || hasRoleModuleAction('organization', 'delete')) && isValidId(departmentId);
    }

    match /floors/{floorId} {
      allow list, get: if isActiveUser();
      allow create: if (isAdmin() || hasRoleModuleAction('organization', 'add')) && isValidId(floorId);
      allow update: if (isAdmin() || hasRoleModuleAction('organization', 'edit')) && isValidId(floorId);
      allow delete: if (isAdmin() || hasRoleModuleAction('organization', 'delete')) && isValidId(floorId);
    }

    match /sections/{sectionId} {
      allow list, get: if isActiveUser();
      allow create: if (isAdmin() || hasRoleModuleAction('organization', 'add')) && isValidId(sectionId);
      allow update: if (isAdmin() || hasRoleModuleAction('organization', 'edit')) && isValidId(sectionId);
      allow delete: if (isAdmin() || hasRoleModuleAction('organization', 'delete')) && isValidId(sectionId);
    }

    match /lines/{lineId} {
      allow list, get: if isActiveUser();
      allow create: if (isAdmin() || hasRoleModuleAction('organization', 'add')) && isValidId(lineId);
      allow update: if (isAdmin() || hasRoleModuleAction('organization', 'edit')) && isValidId(lineId);
      allow delete: if (isAdmin() || hasRoleModuleAction('organization', 'delete')) && isValidId(lineId);
    }

    // 11. Shift Schedules & Server-Managed Rosters
    match /shifts/{shiftId} {
      allow list, get: if isActiveUser();
      allow create: if (isAdmin() || hasRoleModuleAction('shifts', 'add')) && isValidId(shiftId);
      allow update: if (isAdmin() || hasRoleModuleAction('shifts', 'edit')) && isValidId(shiftId);
      allow delete: if (isAdmin() || hasRoleModuleAction('shifts', 'delete')) && isValidId(shiftId);
    }

    match /shift_rosters/{rosterId} {
      allow list, get: if isActiveUser();
      allow create, update, delete: if false; // Strictly via authenticated backend API (Admin SDK)
    }

    // 12. System Settings
    match /system_settings/{settingId} {
      allow list, get: if isActiveUser();
      allow create, update, delete: if isSuperAdmin() && isValidId(settingId);
    }

    // 13. Users Profile Collection
    match /users/{userId} {
      allow list: if isSuperAdmin();
      allow get: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId);
      allow create, update: if isValidId(userId) && (isSuperAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // 14. Account Security & Lockout State (Admin SDK Only Writes)
    match /account_security/{secId} {
      allow list, get: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // 15. Login Attempts Immutable Ledger (Admin SDK Only Writes)
    match /login_attempts/{attemptId} {
      allow list, get: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // 16. Security Governance Audit Logs (Admin SDK Only Writes)
    match /security_audit_logs/{logId} {
      allow list, get: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // 17. Distributed IP Rate Limits (Backend Admin SDK Only — Zero Client Access)
    match /ip_rate_limits/{limitId} {
      allow read, write: if false;
    }

    // 18. Company Wi-Fi Access Control (Super Admin Read / Firebase Admin SDK Only Writes)
    match /company_wifi_networks/{networkId} {
      allow list, get: if isSuperAdmin();
      allow create, update, delete: if false; // Strictly Firebase Admin SDK only
    }

    match /company_wifi_access_policies/{roleId} {
      allow list, get: if isSuperAdmin();
      allow create, update, delete: if false; // Strictly Firebase Admin SDK only
    }

    match /company_wifi_settings/{settingId} {
      allow list, get: if isSuperAdmin();
      allow create, update, delete: if false; // Strictly Firebase Admin SDK only
    }

    match /company_wifi_access_logs/{logId} {
      allow list, get: if isSuperAdmin();
      allow create, update, delete: if false; // Strictly Firebase Admin SDK only
    }

    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
