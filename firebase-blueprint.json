{
  "entities": {
    "Employee": {
      "title": "Employee",
      "description": "Master employee record",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "description": "Unique Employee ID e.g. JMD12345" },
        "employeeName": { "type": "string", "description": "Full name of the employee" },
        "employeeType": { "type": "string", "enum": ["Permanent", "Staff", "Offroll"] },
        "section": { "type": "string", "description": "Section assigned" },
        "department": { "type": "string", "description": "Department assigned" },
        "floor": { "type": "string", "description": "Floor assigned" },
        "designation": { "type": "string", "description": "Job designation" },
        "qrCodeToken": { "type": "string", "description": "Unique security token for QR validation" },
        "employeeStatus": { "type": "string", "enum": ["Active", "Inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["employeeId", "employeeName", "employeeType", "section", "department", "floor", "employeeStatus"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance record per employee and shift cycle",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "employeeNameSnapshot": { "type": "string" },
        "employeeTypeSnapshot": { "type": "string" },
        "floorIdSnapshot": { "type": "string" },
        "sectionIdSnapshot": { "type": "string" },
        "departmentIdSnapshot": { "type": "string" },
        "shiftId": { "type": "string" },
        "shiftDate": { "type": "string", "description": "YYYY-MM-DD shift date" },
        "punchIn": { "type": "string", "format": "date-time" },
        "scheduledPunchOut": { "type": "string" },
        "actualPunchOut": { "type": "string", "format": "date-time" },
        "effectivePunchOut": { "type": "string", "format": "date-time" },
        "punchOutType": { "type": "string", "enum": ["ACTUAL", "AUTO", "NONE"] },
        "regularDutyMinutes": { "type": "number" },
        "overtimeMinutes": { "type": "number" },
        "attendanceStatus": { "type": "string", "enum": ["PRESENT", "LATE", "MISSED PUNCH OUT", "AUTO CLOSED", "COMPLETED", "EARLY EXIT"] },
        "qrTokenReference": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["employeeId", "shiftId", "shiftDate", "punchIn", "attendanceStatus"]
    },
    "Floor": {
      "title": "Floor",
      "description": "Floor configuration master",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "order": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] }
      },
      "required": ["id", "name", "status"]
    },
    "Section": {
      "title": "Section",
      "description": "Section configuration master",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "floorId": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] }
      },
      "required": ["id", "name", "status"]
    },
    "Department": {
      "title": "Department",
      "description": "Department configuration master",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] }
      },
      "required": ["id", "name", "status"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Shift timing configuration master",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "startTime": { "type": "string", "description": "HH:mm format (e.g. 09:00)" },
        "endTime": { "type": "string", "description": "HH:mm format (e.g. 17:30)" },
        "scheduledDurationMinutes": { "type": "number", "description": "Default 510 (8h30m)" },
        "punchInWindowStart": { "type": "string", "description": "HH:mm window start" },
        "punchInWindowEnd": { "type": "string", "description": "HH:mm window end" },
        "isOvernight": { "type": "boolean" },
        "gracePeriodMinutes": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] }
      },
      "required": ["id", "name", "startTime", "endTime", "scheduledDurationMinutes"]
    },
    "ShiftRoster": {
      "title": "ShiftRoster",
      "description": "Daily scheduled expected attendance roster",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shiftDate": { "type": "string" },
        "shiftId": { "type": "string" },
        "employeeId": { "type": "string" },
        "rosterStatus": { "type": "string", "enum": ["SCHEDULED", "LEAVE", "WEEKLY_OFF", "HOLIDAY"] },
        "remarks": { "type": "string" }
      },
      "required": ["shiftDate", "shiftId", "employeeId", "rosterStatus"]
    },
    "PunchLog": {
      "title": "PunchLog",
      "description": "Raw scan and punch audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "action": { "type": "string", "enum": ["PUNCH_IN", "PUNCH_OUT", "REJECTED_DUPLICATE", "REJECTED_INACTIVE", "REJECTED_TOKEN", "REJECTED_SHIFT"] },
        "rawPayload": { "type": "string" },
        "scannerDevice": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["employeeId", "timestamp", "action"]
    },
    "PunchEvent": {
      "title": "PunchEvent",
      "description": "Individual attendance punch event (IN or OUT)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "eventType": { "type": "string", "enum": ["IN", "OUT"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "shiftDate": { "type": "string" },
        "shiftId": { "type": "string" },
        "scannerType": { "type": "string", "enum": ["IN", "OUT"] },
        "scannerDevice": { "type": "string" },
        "dutyDurationMinutes": { "type": "number" },
        "overtimeMinutes": { "type": "number" }
      },
      "required": ["id", "employeeId", "eventType", "timestamp", "shiftDate"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Enterprise system activity and security audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 128 },
        "eventType": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["AUTH", "ACCOUNT", "EMPLOYEE", "ATTENDANCE", "QR", "ORG", "PERMISSIONS", "EXPORT", "SETTINGS", "SECURITY", "AUDIT_LIFECYCLE", "SYSTEM"] },
        "severity": { "type": "string", "enum": ["INFO", "WARNING", "CRITICAL"] },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorLoginId": { "type": "string", "maxLength": 128 },
        "actorRole": { "type": "string", "maxLength": 64 },
        "targetId": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "format": "date-time" },
        "oldValue": { "type": "string", "maxLength": 8000 },
        "newValue": { "type": "string", "maxLength": 8000 },
        "actionSource": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 2000 },
        "success": { "type": "boolean" },
        "ipAddress": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "isImportant": { "type": "boolean" },
        "isProtected": { "type": "boolean" },
        "archived": { "type": "boolean" }
      },
      "required": ["action", "timestamp"]
    },
    "LoginHistory": {
      "title": "LoginHistory",
      "description": "Trusted server-captured login, logout, and IP/geolocation telemetry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "eventType": { "type": "string", "enum": ["LOGIN_SUCCESS", "LOGIN_FAILED", "LOGIN_LOCKED", "LOGOUT", "SESSION_EXPIRED"] },
        "loginId": { "type": "string", "maxLength": 128 },
        "authUid": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "string", "format": "date-time" },
        "success": { "type": "boolean" },
        "ipAddress": { "type": "string", "maxLength": 128 },
        "browser": { "type": "string", "maxLength": 128 },
        "os": { "type": "string", "maxLength": 128 },
        "deviceType": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "eventType", "loginId", "timestamp", "success"]
    },
    "AuditArchive": {
      "title": "AuditArchive",
      "description": "Reviewed non-critical audit logs archived per retention policy",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "format": "date-time" },
        "archivedAt": { "type": "string", "format": "date-time" },
        "archivedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "action", "timestamp", "archivedAt", "archivedBy"]
    },
    "AuditLogDeletion": {
      "title": "AuditLogDeletion",
      "description": "Immutable permanent ledger of Super Admin approved controlled log deletions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "deletedLogId": { "type": "string", "maxLength": 128 },
        "deletedAction": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "approvedByUid": { "type": "string", "maxLength": 128 },
        "approvedByLoginId": { "type": "string", "maxLength": 128 },
        "deletedAt": { "type": "string", "format": "date-time" },
        "ipAddress": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "deletedLogId", "reason", "approvedByUid", "approvedByLoginId", "deletedAt"]
    },
    "PasswordResetLog": {
      "title": "PasswordResetLog",
      "description": "Immutable log of Super Admin password resets and account unlocks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "targetLoginId": { "type": "string", "maxLength": 128 },
        "performedByLoginId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetLoginId", "performedByLoginId", "timestamp"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Global application and security retention configuration",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "websiteName": { "type": "string" },
        "timezone": { "type": "string" },
        "dateFormat": { "type": "string" },
        "timeFormat": { "type": "string" },
        "autoPunchOutEnabled": { "type": "boolean" },
        "lateGraceMinutes": { "type": "number" },
        "overtimeThresholdMinutes": { "type": "number" },
        "auditRetentionDays": { "type": "number" },
        "protectCriticalLogs": { "type": "boolean" },
        "captureGeoLocation": { "type": "boolean" },
        "failedLoginAlertThreshold": { "type": "number" }
      },
      "required": ["companyName", "websiteName", "timezone"]
    },
    "UserRole": {
      "title": "UserRole",
      "description": "RBAC user role structure",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "USER", "super_admin", "admin", "user"] },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "modulesAllowed": { "type": "string" }
      },
      "required": ["id", "name", "role", "status"]
    },
    "RolePermission": {
      "title": "RolePermission",
      "description": "Role-based granular module permissions (View, Add, Edit, Delete)",
      "type": "object",
      "properties": {
        "roleId": { "type": "string", "enum": ["super_admin", "admin", "user"] },
        "modulePermissions": { "type": "string", "description": "JSON map of module permissions" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "description": "Login ID of Super Admin who updated" }
      },
      "required": ["roleId", "updatedAt"]
    },
    "Role": {
      "title": "Role",
      "description": "Predefined system role definitions (super_admin, admin, user)",
      "type": "object",
      "properties": {
        "roleId": { "type": "string", "enum": ["super_admin", "admin", "user"] },
        "roleName": { "type": "string" },
        "description": { "type": "string" },
        "defaultPermissions": { "type": "string" },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roleId", "roleName", "description", "isActive", "updatedAt"]
    },
    "UserPermission": {
      "title": "UserPermission",
      "description": "Individual account level permission overrides",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "loginId": { "type": "string" },
        "role": { "type": "string" },
        "permissions": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["userId", "loginId", "updatedAt"]
    },
    "AccountSecurity": {
      "title": "AccountSecurity",
      "description": "Server-managed account lock status, consecutive failed login counters, and last IP/device telemetry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loginId": { "type": "string" },
        "role": { "type": "string" },
        "firebaseUid": { "type": "string" },
        "email": { "type": "string" },
        "lockStatus": { "type": "string", "enum": ["ACTIVE", "LOCKED"] },
        "consecutiveFailedAttempts": { "type": "number" },
        "maxAttemptsAllowed": { "type": "number" },
        "totalLoginAttempts": { "type": "number" },
        "totalSuccessfulLogins": { "type": "number" },
        "totalFailedLogins": { "type": "number" },
        "forcePasswordChange": { "type": "boolean" },
        "lockedAt": { "type": "string" },
        "lockReason": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "loginId", "role", "lockStatus", "consecutiveFailedAttempts", "updatedAt"]
    },
    "LoginAttempt": {
      "title": "LoginAttempt",
      "description": "Permanent immutable audit history of every login attempt with server IP, geo, and device info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "loginId": { "type": "string" },
        "role": { "type": "string" },
        "firebaseUid": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "timestampMs": { "type": "number" },
        "success": { "type": "boolean" },
        "outcome": { "type": "string" },
        "failureReasonCategory": { "type": "string" },
        "ipAddress": { "type": "string" },
        "browser": { "type": "string" },
        "os": { "type": "string" },
        "deviceType": { "type": "string" }
      },
      "required": ["id", "loginId", "timestamp", "success", "outcome", "ipAddress"]
    },
    "SecurityAuditLog": {
      "title": "SecurityAuditLog",
      "description": "Immutable security governance trail for lockouts, unblocks, temporary password resets, and rate-limit events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "severity": { "type": "string", "enum": ["INFO", "WARNING", "CRITICAL"] },
        "targetLoginId": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorLoginId": { "type": "string" },
        "actorRole": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "ipAddress": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["id", "action", "severity", "actorUid", "actorLoginId", "timestamp"]
    }
  },
  "firestore": {
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Employee master records"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Daily employee attendance records"
    },
    "/floors/{floorId}": {
      "schema": "Floor",
      "description": "Floor master records"
    },
    "/sections/{sectionId}": {
      "schema": "Section",
      "description": "Section master records"
    },
    "/departments/{departmentId}": {
      "schema": "Department",
      "description": "Department master records"
    },
    "/shifts/{shiftId}": {
      "schema": "Shift",
      "description": "Configured shift records"
    },
    "/shift_rosters/{rosterId}": {
      "schema": "ShiftRoster",
      "description": "Expected roster records"
    },
    "/punch_logs/{logId}": {
      "schema": "PunchLog",
      "description": "Raw scan punch logs"
    },
    "/punch_events/{eventId}": {
      "schema": "PunchEvent",
      "description": "Individual punch event logs"
    },
    "/audit_logs/{auditId}": {
      "schema": "AuditLog",
      "description": "System activity and security audit logs"
    },
    "/login_history/{historyId}": {
      "schema": "LoginHistory",
      "description": "Trusted server-captured login/logout IP, geo, and device telemetry"
    },
    "/audit_archives/{archiveId}": {
      "schema": "AuditArchive",
      "description": "Archived non-critical audit logs post 90-day retention review"
    },
    "/audit_log_deletions/{deletionId}": {
      "schema": "AuditLogDeletion",
      "description": "Immutable permanent ledger of controlled log deletions"
    },
    "/password_reset_logs/{logId}": {
      "schema": "PasswordResetLog",
      "description": "Immutable Super Admin password reset logs"
    },
    "/system_settings/{settingId}": {
      "schema": "SystemSetting",
      "description": "Global system settings"
    },
    "/user_roles/{userRoleId}": {
      "schema": "UserRole",
      "description": "User rights and role master"
    },
    "/role_permissions/{roleId}": {
      "schema": "RolePermission",
      "description": "Granular role-based permissions matrix"
    },
    "/roles/{roleId}": {
      "schema": "Role",
      "description": "System role definitions and descriptions"
    },
    "/user_permissions/{permissionId}": {
      "schema": "UserPermission",
      "description": "Individual account permission overrides"
    },
    "/account_security/{secId}": {
      "schema": "AccountSecurity",
      "description": "Server-managed account lock status and consecutive failed login counters"
    },
    "/login_attempts/{attemptId}": {
      "schema": "LoginAttempt",
      "description": "Permanent immutable login attempt history"
    },
    "/security_audit_logs/{logId}": {
      "schema": "SecurityAuditLog",
      "description": "Immutable security governance audit trail"
    }
  }
}
